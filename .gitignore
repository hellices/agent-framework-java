.worktrees/

# Gradle writes outputs to a `build/` directory in every project. Listing project paths one by one
# lets a newly registered module leak its outputs into a commit, so match the directory name
# anywhere instead. `build-logic/` and `build-tools/` are sources and stay tracked; only their
# `build/` output directories are ignored by this rule.
build/
.gradle/
.kotlin/
out/
bin/
.gradle-bootstrap/

# Byproduct of `./gradlew ... --write-locks`. Settings-level dependency locking is not activated,
# so this file locks nothing; only project lockfiles such as
# build-tools/harness-policy/gradle.lockfile are committed.
/settings-gradle.lockfile

.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

.DS_Store
Thumbs.db

*.log
*.hprof
hs_err_pid*
replay_pid*

.harness/runs/
.claude/settings.local.json
.gemini/settings.local.json
.copilot/
*.env
*.pem
*.key
kubeconfig
gradle-local.properties
