<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <Match>
    <Class name="~.*\.generated\..*"/>
  </Match>
  <!-- Map.copyOf creates the immutable representation returned by this accessor. -->
  <Match>
    <Class name="io.github.hellices.agentframework.api.message.Message"/>
    <Method name="additionalProperties"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
</FindBugsFilter>
