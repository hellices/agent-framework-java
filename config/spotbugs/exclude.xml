<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <Match>
    <Class name="~.*\.generated\..*"/>
  </Match>
  <!-- Map.copyOf creates an unmodifiable shallow copy; the accessor exposes no mutable map. -->
  <Match>
    <Class name="io.github.hellices.agentframework.api.message.Message"/>
    <Method name="additionalProperties"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <!-- SessionContext is intentionally a single, shared, mutable per-run object (SES-011): Agent hands
       the exact same instance to AgentRunContext and to its own completion callback so the response
       slot can be filled once the run finishes. Storing and exposing that shared reference is the
       design, not an accidental leak of caller state. -->
  <Match>
    <Class name="io.github.hellices.agentframework.api.agent.AgentRunContext"/>
    <Method name="sessionContext"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="io.github.hellices.agentframework.api.agent.AgentRunContext"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- Message is a final value type whose own collection components are defensively copied, and the
       framework already hands the same instances around as List<Message>. Pairing one with the
       provider that contributed it therefore stores and exposes no mutable caller state; copying the
       message here would instead break identity comparisons against the run's context messages. -->
  <Match>
    <Class name="io.github.hellices.agentframework.api.session.ContextMessageContribution"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- The MCP adapter borrows its collaborators on purpose. It must call the very client the caller
       connected, so copying or re-wrapping it would either lose the live connection or take over a
       lifecycle the caller owns, which is exactly what MCP-001 forbids. McpToolAdapterOptions is a
       deeply immutable value whose collections are already copied at construction. -->
  <Match>
    <Class name="io.github.hellices.agentframework.mcp.internal.BorrowedMcpAsyncOperations"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="io.github.hellices.agentframework.mcp.internal.McpToolDiscovery"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="io.github.hellices.agentframework.mcp.internal.McpArgumentMapper"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="io.github.hellices.agentframework.mcp.internal.McpResultMapper"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- The owned stdio builder records the collaborators the caller configured. The JSON mapper must
       be the very instance the caller passed, because the SDK transport encodes every message with
       it and an implementation of that interface cannot be copied. McpToolAdapterOptions is a
       deeply immutable value whose collections are already copied at construction, which is why
       McpToolDiscovery stores it the same way. The mutable part of the configuration, the process
       command line, is deliberately not stored: the builder copies it into a String, a List.copyOf,
       and a Map.copyOf, so no exclusion is needed for it. -->
  <Match>
    <Class name="io.github.hellices.agentframework.mcp.McpStdioTools$Builder"/>
    <Method name="jsonMapper"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="io.github.hellices.agentframework.mcp.McpStdioTools$Builder"/>
    <Method name="toolOptions"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
